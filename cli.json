{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode",
    "mode": "dark"
  },
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "show",
    "grouping": "auto",
    "verbosity": "high",
    "new_location": "launch"
  },
  "tabs": {
    "indicators": "numbers",
    "layout": "horizontal",
    "enabled": true,
    "mode": "on"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 1
  },
  "prompt": {
    "image_preview": true,
    "paste": "full"
  },
  "debug": {
    "devtools": false,
    "turn_tokens": true
  },
  "highlights": true
}
